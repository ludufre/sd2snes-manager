# Deploy target for ./deploy.sh
#
# Copy this file to `.env` and fill in your own server. `.env` is gitignored, so
# your address never reaches the repository.
#
#     cp .env.example .env
#
# You can also export these in the shell instead of using a file; the environment
# wins over `.env`.

# user@host of the machine serving the built app.
SSH_HOST=user@example.com

# SSH port. Optional, defaults to 22.
SSH_PORT=22

# Absolute path on the server that the build is rsynced into. The trailing slash
# matters: the CONTENTS of the build land here, not the folder itself.
SSH_DEST=/var/www/manager/
